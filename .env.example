# Copy to a private dotenv file; pass its path with -env-file.
# Existing environment variables override dotenv values.
HTTP_ADDR=127.0.0.1:8080
SQLITE_PATH=data/paper-scout.sqlite
CACHE_DIR=data/cache
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set an available Chat Completions model explicitly; no hard-coded alias.
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_THINKING=disabled
# Seed and embedding settings are added by their owning DAG nodes.

# Disable automatic research recall/capture only for an explicit control run.
RESEARCH_MEMORY_ENABLED=true
